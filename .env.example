# NEXT_PUBLIC_ values are bundled into browser JavaScript. Restrict the Google
# key by referrer; Supabase's publishable key relies on Row Level Security.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
NEXT_PUBLIC_GOOGLE_MAP_ID=your_google_maps_map_id
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
# Choose `json` for the bundled snapshot or `postgres` for PostGIS.
GTFS_DATA_SOURCE=postgres
# Optional override for a configured feed:
# GTFS_FEED_URL=https://example.com/gtfs.zip
