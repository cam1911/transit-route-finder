{
  "name": "dallas-transit-nearby",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "quality": "npm run lint && npm run fallow:dead-code && npm run fallow:dupes && npm run fallow:health:gate",
    "fallow": "fallow",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:health:gate": "fallow health --baseline .fallow-health-baseline.json --baseline-mode identity --fail-on-issues --summary",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:db": "supabase test db --local",
    "db:start": "supabase db start",
    "browser:install": "playwright install chromium && agent-browser install",
    "import:dart": "node scripts/import-dart.mjs",
    "import:gtfs": "node scripts/gtfs/import.mjs",
    "import:local": "node scripts/gtfs/import-local.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "adm-zip": "^0.6.1",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "agent-browser": "0.38.1",
    "fallow": "3.30.0",
    "supabase": "2.118.0",
    "tailwindcss": "^4.1.13"
  }
}
